---
import { existsSync } from 'node:fs';
import Base from '../layouts/Base.astro';
import TagList from '../components/TagList.astro';
import { site } from '../site';

// Drop your CV at public/cv.pdf and the download link appears automatically.
const hasCv = existsSync(new URL('../../public/cv.pdf', import.meta.url));

const skills = [
  { area: 'Languages', items: ['HTML', 'CSS', 'JavaScript', 'PHP', 'C#', 'Python'] },
  { area: 'Frameworks', items: ['Laravel', 'Blade', 'Bootstrap'] },
  { area: 'Databases', items: ['MySQL', 'SQLite'] },
  { area: 'Security', items: ['OWASP Top 10', 'SQL injection', 'XSS', 'CSRF', 'Access control'] },
  { area: 'Tools', items: ['Git', 'GitHub', 'Composer'] },
];

// TODO: add years, employers and your school/program if you want them shown
const experience = [
  {
    when: 'Now',
    role: 'Web development',
    org: 'career change',
    note: 'Building projects in Laravel, PHP and JavaScript, with a focus on writing secure code.',
  },
  {
    when: '10+ years',
    role: 'Food industry',
    org: 'various roles',
    note: 'Fast-paced, team-based work where quality, safety and consistency matter every day.',
  },
];
---

<Base title="About" description={`About ${site.name}: background, skills and experience.`}>
  <article class="container reveal">
    <h1>About</h1>

    <div class="prose bio">
      <p>
        I spent more than ten years in the food industry before deciding to move into software. That work taught me to
        stay calm under pressure, work closely with a team, and care about getting the details right every time.
      </p>
      <p>
        Now I build web applications with HTML, CSS, JavaScript, Laravel and C#, and I've been learning how to find and
        fix common security flaws. I'm most interested in health-related software, building tools that help people
        look after themselves.
      </p>
      <p>
        Outside of code I like working out and staying active, reading, and gaming.
      </p>
    </div>

    <section aria-labelledby="skills">
      <h2 id="skills">Skills</h2>
      <dl class="skills">
        {
          skills.map((s) => (
            <div>
              <dt class="mono">{s.area}</dt>
              <dd><TagList tags={s.items} /></dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section aria-labelledby="experience">
      <h2 id="experience">Experience</h2>
      <ol class="timeline">
        {
          experience.map((e) => (
            <li>
              <span class="mono">{e.when}</span>
              <div>
                <p class="role">{e.role}, {e.org}</p>
                <p class="muted">{e.note}</p>
              </div>
            </li>
          ))
        }
      </ol>
      {hasCv && <p><a class="link" href="/cv.pdf" download>Download CV (PDF)</a></p>}
    </section>

    <section id="contact" aria-labelledby="contact-heading">
      <h2 id="contact-heading">Contact</h2>
      <p class="muted">
        I'm looking for web developer roles in Ontario or remote. Email is the best way to reach me.
      </p>
      <p class="email"><a class="link" href={`mailto:${site.email}`}>{site.email}</a></p>
      <ul class="socials">
        {site.socials.map((s) => <li><a class="link" href={s.href} rel="me noopener">{s.label}</a></li>)}
      </ul>
    </section>
  </article>
</Base>

<style>
  article {
    padding-top: var(--s8);
  }
  h1 {
    font-size: clamp(32px, 6vw, 44px);
    letter-spacing: -0.03em;
    margin-bottom: var(--s4);
  }
  .bio {
    font-size: 18px;
  }
  section {
    margin-top: var(--s8);
  }
  h2 {
    font-size: 22px;
    margin-bottom: var(--s3);
  }
  .skills {
    display: grid;
    gap: var(--s2);
    margin: 0;
  }
  .skills > div {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: var(--s2);
    align-items: baseline;
  }
  .skills dd {
    margin: 0;
  }
  .timeline {
    list-style: none;
    margin: 0 0 var(--s3);
    padding: 0;
  }
  .timeline li {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: var(--s2);
    padding-block: var(--s2);
    border-top: 1px solid var(--border);
  }
  .timeline li:last-child {
    border-bottom: 1px solid var(--border);
  }
  .timeline p {
    margin: 0;
  }
  .role {
    font-weight: 500;
  }
  .email {
    font-size: clamp(22px, 4vw, 28px);
    letter-spacing: -0.02em;
    margin-block: var(--s3);
  }
  .socials {
    display: flex;
    gap: var(--s3);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (max-width: 520px) {
    .skills > div,
    .timeline li {
      grid-template-columns: 1fr;
      gap: 6px;
    }
  }
</style>
