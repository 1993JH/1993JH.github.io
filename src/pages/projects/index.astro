---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => b.data.year - a.data.year || a.data.order - b.data.order,
);
---

<Base title="Projects" description="Selected software projects and case studies.">
  <section class="container reveal">
    <h1>Projects</h1>
    <p class="muted lede">Things I've built. Each one links to a short write-up.</p>
    <ul class="list">
      {projects.map((p) => <ProjectCard project={p} />)}
    </ul>
  </section>
</Base>

<style>
  section {
    padding-top: var(--s8);
  }
  h1 {
    font-size: clamp(32px, 6vw, 44px);
    letter-spacing: -0.03em;
    margin-bottom: var(--s2);
  }
  .lede {
    font-size: 18px;
    margin-bottom: var(--s6);
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
