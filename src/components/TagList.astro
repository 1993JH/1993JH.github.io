---
interface Props {
  tags: string[];
}
const { tags } = Astro.props;
---

<ul aria-label="Tech stack">
  {tags.map((t) => <li>{t}</li>)}
</ul>

<style>
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-2);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 1px 7px;
  }
</style>
